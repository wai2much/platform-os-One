# Platform OS (Slim) — product build.
# The product will run on its own MULTI-TENANT backend (not v2.5's single-tenant
# TyrePlus project). During early build we may point at a dev Supabase project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The org id the unauthenticated Customer Booking Portal (/book) submits
# bookings under, since there's no signed-in user there to derive a tenant
# from. Find your org's id in Supabase -> Table Editor -> organizations,
# after your first Google sign-in (see supabase/schema.sql Phase 1).
VITE_DEFAULT_ORG_ID=

# --- Zeller Terminal Payments SDK npm registry (2026-08-09). The
# @zeller-public/payments-sdk-react package (see src/lib/zeller.jsx and
# .npmrc) lives on Zeller's own private JFrog registry, not npmjs.com. This
# is a BUILD-TIME variable, not a Vite runtime one (no VITE_ prefix on
# purpose) — it has to be set wherever `npm install` runs: locally in your
# shell before installing, AND as a Vercel Environment Variable, or every
# deploy will fail to install this dependency.
# The token that came from Zeller's own quickstart docs was the same value
# across every framework's page (React/React Native/.NET) — it reads like a
# shared public-scope pull token for the @zeller-public registry, not a
# per-account secret, but it's still handled as one here on principle:
# never committed, .npmrc references it by variable only.
ZELLER_NPM_TOKEN=

# --- Server-side only below this line — NO VITE_ prefix, so Vite never bundles
# these into the browser. Set as Vercel Environment Variables, never committed,
# never pasted into chat. Each api/* route degrades gracefully ("not
# configured") when its var is missing, same pattern as the app's fallback mode.

# London (Grok Voice Agent Builder — real product, launched by xAI 1 Jul 2026;
# console.x.ai/voice/agents). XAI_AGENT_ID is a real agent already created there.
# Used by api/grok/test-connection.js, api/grok/test-call.js (older chat-API
# stand-ins, predate the real Voice Agent product) and api/grok/voice-webhook.js
# (receives realtime.call.incoming events; logs to Supabase voice_agent_events).
# Telephony: bridged to TyrePlus's existing 3CX line via a byo_trunk SIP setup —
# that trunk config + registering this webhook's URL happens in console.x.ai,
# not in this repo. (No GROK_VOICE_AGENT.md handoff file actually exists in
# this repo despite older comments referencing one — stale reference, ignore.)
XAI_API_KEY=xai-...
XAI_AGENT_ID=agent_w54p3rF4EgKG1y4I

# Xero OAuth — see XERO_INTEGRATION.md handoff.
# Used by api/xero/authorize.js and api/xero/callback.js.
XERO_CLIENT_ID=...
XERO_CLIENT_SECRET=...
XERO_REDIRECT_URI=https://platform-os-slim.vercel.app/api/xero/callback

# Supabase service role key — bypasses RLS, needed ONLY by api/xero/callback.js
# and api/xero/status.js to read/write xero_tokens (which grants nothing to
# the public anon key on purpose, since it holds real OAuth secrets).
# Get from Supabase -> Project Settings -> API -> service_role. Guard this
# closely — unlike the anon key, it is NOT safe to expose anywhere client-side.
SUPABASE_SERVICE_ROLE_KEY=...

# --- Zeller Payments — NOT a Vercel env var. Wai's chosen payment processor
# (2026-08-09 decision — hardcoded, not an abstracted multi-provider layer;
# see DESIGN.md), mirroring how Podium sits on Stripe. Runs as a Supabase
# Edge Function (supabase/functions/zellerPayments), so set via the Supabase
# CLI/dashboard, same as Mercedes' secrets below:
#   supabase functions deploy zellerPayments
#   supabase secrets set ZELLER_API_KEY=...
# Get ZELLER_API_KEY from the Zeller Developer Suite once your app/account
# there is set up: https://www.myzeller.com/au/developer-suite
# Until this is set, zellerPayments returns an honest stub response instead
# of pretending to create a real payment link — see that function's comments.
ZELLER_API_KEY=
ZELLER_API_BASE=https://api.myzeller.com

# --- Mercedes (Hyper Agent) — NOT a Vercel env var. She runs as a Supabase
# Edge Function (supabase/functions/mercedesChat), so her secrets are set via
# the Supabase CLI/dashboard instead, once per project:
#   supabase functions deploy mercedesChat
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   (same value as above)
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically for deployed
# functions — no need to set those two yourself.
# Mercedes voice (MiniMax T2A speech-02-turbo/hd) — see jarvis-minimax skill
# for the wiring spec. Used by api/mercedes/speak.js. MINIMAX_GROUP_ID is
# required by MiniMax's endpoint (passed as a URL query param) and has no
# default — the route reports "not configured" until both vars are set.
# Mercedes' voice ID defaults in code; only override MERCEDES_VOICE_ID if the
# clone is replaced. Never point this at the JARVIS voice ID — separate agent.
MINIMAX_API_KEY=sk-...
MINIMAX_GROUP_ID=
MERCEDES_VOICE_ID=moss_audio_36bc73ae-125a-11f1-b31e-0a631a267b2a
